<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ════════════════════════════════════════════════════════════════
	     第一部分：App 自带权限（必须原样保留）
	     ════════════════════════════════════════════════════════════════
	     依据：能正常运行的 Minis112 包里实测带的就是这 9 条。
	     其中 application-groups 尤其关键 —— Minis 启动时要用
	     group.com.ly.minis 容器存放数据库与 rootfs，拿不到就会崩。

	     之前这 9 条被整套丢掉了（签名只用了一份新的私有权限清单），
	     这是启动 SIGTRAP 的直接原因。 -->

	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ly.minis</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.ly.minis</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.ly.minis</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array>
		<string>health-records</string>
	</array>
	<key>com.apple.developer.homekit</key>
	<true/>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
		<string>PACE</string>
	</array>

	<!-- ════════════════════════════════════════════════════════════════
	     第二部分：ly 新功能所需（最小集）
	     ════════════════════════════════════════════════════════════════ -->

	<!-- apple-hid：系统级触控 / 键盘注入（驱动别的 App） -->
	<key>com.apple.private.hid.client.event-dispatch</key>
	<true/>
	<key>com.apple.private.hid.client.event-filter</key>
	<true/>

	<!-- apple-hid screenshot：全屏截图（含别的 App 画面） -->
	<key>com.apple.private.iosurface</key>
	<true/>
	<key>com.apple.private.coregraphics</key>
	<true/>

	<!-- apple-apps：枚举已安装 App -->
	<key>com.apple.private.mobileinstall.allowedSPI</key>
	<array>
		<string>Lookup</string>
		<string>Browse</string>
	</array>

	<!-- iSH(JIT 模拟器) 需要：可执行内存 -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- ════════════════════════════════════════════════════════════════
	     ⚠️ 刻意不包含的权限（曾有 10 条，已全部移除）
	     ════════════════════════════════════════════════════════════════
	     这些会改变进程的沙箱/容器语义，而原本能正常运行的包一条都没有，
	     属于启动崩溃的高度嫌疑对象：

	       platform-application                          ← 让进程被当成系统应用，
	                                                       容器路径与权限模型全变
	       com.apple.private.security.no-sandbox         ← 直接去掉沙箱
	       com.apple.private.security.no-container
	       com.apple.private.security.storage.AppDataContainers
	       task_for_pid-allow / get-task-allow           ← TrollStore 安装时自己会加
	       com.apple.security.cs.disable-library-validation
	       com.apple.security.cs.allow-dyld-environment-variables
	       com.apple.private.backgroundtask.allow

	     如果后续发现 apple-hid 因缺少 platform-application 而不可用，
	     再单独把它加回来验证 —— 一次只改一个变量。 -->
</dict>
</plist>
