<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ═══════════════════════════════════════════════════════════
	     ly patch: platform-application 是下面那些 com.apple.private.*
	     真正被 AMFI 放行的前提。缺了它，私有权限会被静默忽略。
	     ═══════════════════════════════════════════════════════════ -->
	<key>platform-application</key>
	<true/>

	<!-- JIT / 动态代码 -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>

	<!-- 调试 / task_for_pid：只对 debuggable(TrollStore 自装)进程有效 -->
	<key>get-task-allow</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<key>com.apple.security.get-task-allow</key>
	<true/>

	<!-- 沙箱缓解：iOS 16 stock 上部分生效，不保证完整去沙箱 -->
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>

	<!-- ═══ ly patch: apple-hid —— 系统级触控/键盘注入 ═══
	     让 agent 能驱动别的 App（合成 IOHIDEvent，系统当真实手指） -->
	<key>com.apple.private.hid.client.event-dispatch</key>
	<true/>
	<key>com.apple.private.hid.client.event-filter</key>
	<true/>

	<!-- ═══ ly patch: apple-hid screenshot —— 全屏截图（含别的 App） ═══ -->
	<key>com.apple.private.iosurface</key>
	<true/>
	<key>com.apple.private.coregraphics</key>
	<true/>

	<!-- ═══ ly patch: apple-apps —— 枚举/启动已安装 App ═══ -->
	<key>com.apple.private.mobileinstall.allowedSPI</key>
	<array>
		<string>Lookup</string>
		<string>Install</string>
		<string>Uninstall</string>
		<string>Browse</string>
	</array>

	<!-- 让后台常驻更容易（驱动别的 App 时本体会退到后台） -->
	<key>com.apple.private.backgroundtask.allow</key>
	<true/>

	<!-- 网络扩展：全流量镜像(SOCKS5 mirror / NE tunnel) -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
		<string>app-proxy-provider</string>
	</array>
	<key>com.apple.developer.networking.vpn-api</key>
	<true/>

	<!-- 文件访问面 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.assets.movies.read-write</key>
	<true/>
	<key>com.apple.security.assets.music.read-write</key>
	<true/>

	<!-- 后台保活(尽量让 executor/隧道活久点) -->
	<key>com.apple.background-networking</key>
	<true/>
	<key>com.apple.developer.background-mode.audio</key>
	<true/>
</dict>
</plist>
